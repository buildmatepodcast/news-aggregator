# Postgres connection (local docker-compose default shown; Railway/Supabase will
# give you their own). IMPORTANT: if your password contains special characters
# (@ : / ? # $ % &), percent-encode them (e.g. "$" -> "%24"). Next.js's own .env
# loader does shell-style $VAR expansion, so a literal "$" in an unencoded
# password gets silently mangled even though Prisma's CLI tolerates it fine -
# percent-encoding avoids the mismatch entirely.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/construction_news"

# Anthropic API key used by the enrichment worker to categorize, summarize,
# and score each article's virality (falls back to a rule-based scorer if unset)
ANTHROPIC_API_KEY=

# How often the ingestion worker polls RSS sources, in minutes
INGEST_INTERVAL_MINUTES=10

# How often the enrichment worker processes the PENDING queue, in seconds
ENRICH_INTERVAL_SECONDS=30

# Optional: webhook URL (e.g. Slack/Discord incoming webhook) to alert if
# ingestion has not completed successfully in this many minutes
ALERT_WEBHOOK_URL=
ALERT_STALL_THRESHOLD_MINUTES=30

# Base URL of the deployed site (used in a couple of absolute-link contexts)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs/verifies the login session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional: if unset, magic-link sign-in emails aren't actually sent - the
# link is returned directly in the API response instead (see src/lib/email.ts)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
